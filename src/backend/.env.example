# Django Settings
SECRET_KEY=django-insecure-opturize-sit-opt-secret-key-unmsm-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS (Frontend TanStack)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Base de Datos (SQLite en local, PostgreSQL en AWS RDS)
DATABASE_URL=sqlite:///db.sqlite3

# Broker MQTT (HiveMQ público para pruebas con Wokwi)
MQTT_BROKER_HOST=broker.hivemq.com
MQTT_BROKER_PORT=1883
MQTT_TELEMETRY_TOPIC=opturize/turismo/+/telemetria
MQTT_CONTROL_TOPIC_PREFIX=opturize/turismo
